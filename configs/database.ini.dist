[mysql]
host =
port = 3306
user =
password =

# ===== CML MODE CONFIGURATION =====

[influx_common]
# Common InfluxDB settings (CML mode)
url =
token =
org = vut

[influx_read]
# CML mode - read bucket
bucket = realtime_cbl
measurements = 1s10, summit, summit_bt
fields = Teplota, PrijimanaUroven
tag_device = agent_host
field_temperature = Teplota
field_signal = PrijimanaUroven
window = 10m
range = -1h

[influx_write]
# CML mode - write bucket
bucket = telcotemp_output
measurement = telcorain
tag_cml_id = cml_id
tag_side = side
field_temperature = temperature


# ===== METEO MODE CONFIGURATION =====

# [influx]
