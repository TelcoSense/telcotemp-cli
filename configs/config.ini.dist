; ============================================================================
; TELCOTEMP-CLI CONFIGURATION (DISTRIBUTION TEMPLATE)
; ============================================================================
; This is a template configuration file for the telcotemp-cli application.
; Copy this file to config.ini and fill in your actual values.
; ============================================================================


; LOGGING CONFIGURATION
[logging]
level = INFO
backend_log = app.log
max_bytes = 10485760
backups = 1
fmt = %(asctime)s -%(funcName)s - %(levelname)s - %(message)s

; DEBUG DIAGNOSTICS
[diagnostics]
enable_bias_report = false
bias_report_dir = outputs_diagnostics

; FILE PATHS CONFIGURATION
[paths]
country_file = country_data/czech_republic.json
dem_tif = country_data/elevation_data.tif
meteo_dir =  outputs_meteo
cml_dir = outputs_cml
color_scale_dir = outputs_raw
saved_grids_dir = saved_grids

; MAP CLEANUP CONFIGURATION
[cleanup]
; Enable/disable automatic cleanup of old map files
enabled = false
; Number of days to keep map files (older files will be deleted)
retention_days = 30

; VISUALIZATION CONFIGURATION
[visualization]
n_levels = 15
colormap = []
median_offset = 2
; Scale mode: 'dynamic' - centered on current median, 'static' - legacy wide fixed scale,
; 'static_cz' - denser Czech-focused fixed absolute scale,
; 'static_cz_adaptive' - same Czech palette, but adaptive window for better daily contrast
scale_mode = static_cz_adaptive

; MACHINE LEARNING CONFIGURATION (CML mode)
[ml]
; Preferred self-contained setup:
; Put a model artifact inside telcotemp/neural/artifacts/<name>/
; with best.pt and scaler_bundle.json.
artifact_dir = telcotemp/neural/artifacts/current
; Default filenames inside artifact_dir:
checkpoint_path = best.pt
scaler_bundle_path = scaler_bundle.json
; Technologies are expected from config to keep runtime self-contained.
technologies = ["1s10", "ceragon_ip_20", "summit", "summit_bt"]
; Optional fallback if you want to read technologies from a file instead:
; prepare_summary_path = prepare_summary.json
; Window settings are provided here in config.
seq_len = 36
sample_minutes = 10
; LSTM model parameters are provided here in config.
model_type = lstm
hidden_size = 96
num_layers = 4
dropout = 0.3
technology_embed_dim = 8
mlp_hidden_size = 96
head_activation = gelu
use_layer_norm = false
bidirectional = true
temporal_readout = last
; Legacy fallback if you still want to point to telcotemp_nn config directly:
; nn_config_path = ../TelcoTemp_NN/configs/lstm_temp.yaml
; model_name = lstm_gelu
; Sequence grouping should match how cml_id was defined during training.
; For the current dataset_preparation pipeline, cml_id = Link_ID + "_" + Side.
; Valid values are any runtime column such as IP, Link_ID, cml_id, or Link_ID_Side.
group_col = cml_id
device = cpu
; Optional batching for larger historical runs.
inference_batch_size = 2048
; Merge nearby CML endpoints into one roof-level point before interpolation.
merge_roofs = true
roof_merge_distance_m = 15
bias_offset = 0.0

; GRID COMPUTATION CONFIGURATION
[grid]
x_points = 500
y_points = 500
mask_resolution_safe = true
save_grids = false

; INTERPOLATION CONFIGURATION
[interpolation]
variogram_model = spherical
nlags = 40
regression_model = linear

; LOCATION CONFIGURATION (for daylight calculation in CML mode)
[location]
lat = 49.8175
lng = 15.4730
tz = Europe/Prague

; DATABASE CONFIGURATION
[mysql]
host = 
port = 3306
user = 
password = 

[influx_common]
url = 
token = 
org = 

; CML MODE CONFIGURATION
[influx_read]
bucket = realtime_cbl
measurements = 1s10, ceragon_ip_20, summit, summit_bt
fields = Teplota, PrijimanaUroven
tag_device = agent_host
field_temperature = Teplota
field_signal = PrijimanaUroven
window = 10m
range = -1h

[influx_write]
bucket = telcorain_output
measurement = telcotemp
tag_cml_id = cml_id
tag_side = side
field_temperature = temperature
enable_write = false

; METEO MODE CONFIGURATION
[influx]
url = 
token = 
org = 
bucket = chmi_data
measurements = T
fields = Temperature
tag_device = agent_host
field_temperature = Temperature
window = 10m
range = -2h
